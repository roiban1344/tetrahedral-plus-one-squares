-- Generated by scripts/generate_norm_precision_data.py; kernel-checked proofs.
import Tetrahedral.NormEleven.DyadicSimple
import Tetrahedral.NormEleven.NormPrecisionData

/-! Two parity classes and norm-constrained remainders replace the old
positive-phase certificates for d=1,3,11. -/
set_option maxRecDepth 10000
set_option maxHeartbeats 0

namespace Tetrahedral.NormEleven

namespace Dyadic1
open Quartic1 R
def step : R := ⟨fun i => ((rho^2-1 : R) i)/4⟩
theorem step_eq : (↑(rhoU^2):R)=1+4*step := by
  have h : (↑(rhoU^2):R)=1+(4:ℤ) • step := by
    ext i; fin_cases i <;> decide +kernel
  simpa only [zsmul_eq_mul,Int.cast_ofNat] using h

theorem roots (m : ℤ) (hm : f (xi0*(↑(rhoU^m):R))=0) : m=0 ∨ m= -1 := by
  apply DyadicSimple.pair f rhoU xi0 ?_ m hm
  intro c i hi
  have hr : ∀ j : ℤ, relH (↑((rhoU^2)^j):R)=1 ∧ relK (↑((rhoU^2)^j):R)=0 := by
    intro j; have h := relN_rho_zpow (2*j); rwa [zpow_mul,zpow_ofNat] at h
  have hz : ∀ c : Fin 2, f (xi0*(↑(rhoU^(DyadicSimple.centre c)):R))=0 := by decide +kernel
  have hk : ∀ c : Fin 2, Lf (xi0*(↑(rhoU^(DyadicSimple.centre c)):R))
      ((xi0*(↑(rhoU^(DyadicSimple.centre c)):R))*step)%16=8 := by decide +kernel
  apply RelativeNormPrecision.unique Precision1.X Precision1.Y 2 f
    (Lf (xi0*(↑(rhoU^(DyadicSimple.centre c)):R))) Qf
    (xi0*(↑(rhoU^(DyadicSimple.centre c)):R)) (rhoU^2) 1 step
    (by norm_num; exact step_eq) (hz c) (f_expand _)
    (Precision1.error 1 (by decide) (rhoU^2) step (by norm_num; exact step_eq) hr)
    (by decide +kernel) (Precision1.linear c) (Precision1.quadratic _) ?_ i hi
  intro a ha
  norm_num at ha
  have h := Int.emod_eq_zero_of_dvd ha
  rw [Int.mul_emod,hk c] at h
  omega

theorem negative (m : ℤ) : f (-(xi0*(↑(rhoU^m):R)))≠0 :=
  DyadicSimple.negative f Lf Qf f_expand rhoU xi0 step step_eq
    (by decide +kernel) (by decide +kernel) m
end Dyadic1

