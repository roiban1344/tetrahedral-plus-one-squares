for every unit direction at a multiple of four. -/
theorem direction (U : R) (q : ℤ) (hq : q≠0)
    (hH : relH (1+(4*q) • U)=1) (hK : relK (1+(4*q) • U)=0) :
    (∀ y : R, (2:ℤ) ∣ (y*U) 0 ∧ (2:ℤ) ∣ (y*U) 1) ∧
