  obtain ⟨hA,hB,hN0,hN1⟩ := trace_norm U q hq hH hK
  obtain ⟨a,haN⟩ := hN0; obtain ⟨b,hbN⟩ := hN1
  have hu0 : U 0=8*(-q*a) := by rw [hA,haN]; ring
  have hu1 : U 1=4*(-q*b) := by rw [hB,hbN]; ring
  have hF0 : (4:ℤ) ∣ (y*U) 0 := by
    simp only [mul_apply0]; rw [hu0,hu1]; ring_nf; omega
  have hF1 : (4:ℤ) ∣ (y*U) 1-2*y 2*U 2 := by
    simp only [mul_apply1]; rw [hu0,hu1]; ring_nf; omega
  exact RelativeDirection.derivative_two (y 0) (y 1) (y 2) (U 2)
    ((y*U) 0) ((y*U) 1) 66 (by decide) ha hb hc hprimitive hF0 hF1



end Tetrahedral.NormEleven.NormProjection11

namespace Tetrahedral.NormEleven.NormProjection66
open Quartic66 R
def coord (j : Fin 4) : R →ₗ[ℤ] ℤ where
  toFun x := x j
  map_add' _ _ := rfl
  map_smul' _ _ := rfl

/-- Evaluation at q=1, s=0 is multiplicative modulo two. -/
theorem parity_mul (x z : R) :
    (2:ℤ) ∣ coord 0 (x*z)+coord 1 (x*z)-(coord 0 x+coord 1 x)*(coord 0 z+coord 1 z) := by
  change (2:ℤ) ∣ (x*z) 0+(x*z) 1-(x 0+x 1)*(z 0+z 1)
  simp only [mul_apply0,mul_apply1]
  ring_nf; omega

end Tetrahedral.NormEleven.NormProjection66

namespace Tetrahedral.NormEleven.NormProjection66
open Quartic66 R
/-- The base coordinates and norm divisibility of a unit direction. -/
theorem trace_norm (U : R) (q : ℤ) (hq : q≠0)
    (hH : relH (1+(4*q) • U)=1) (hK : relK (1+(4*q) • U)=0) :
    U 0= -2*q*relH U ∧ U 1= -2*q*relK U ∧
      (4:ℤ) ∣ relH U ∧ (4:ℤ) ∣ relK U := by
  have eH : relH (1+(4*q) • U)=1+8*q*U 0+16*q^2*relH U := by
    simp only [relH,add_apply,zsmul_apply,one_apply]; norm_num; ring
  have eK : relK (1+(4*q) • U)=8*q*U 1+16*q^2*relK U := by
    simp only [relK,add_apply,zsmul_apply,one_apply]; norm_num; ring
  rw [eH] at hH; rw [eK] at hK
  have hA := RelativeDirection.trace q (U 0) (relH U) hq hH
  have hB := RelativeDirection.trace q (U 1) (relK U) hq (by linarith only [hK])
  have hn := RelativeDirection.norm_four (U 0) (U 1) (relH U) (relK U) q 11 hA hB
    (by simp only [relH]; ring_nf; omega) (by simp only [relK]; ring_nf; omega)
  exact ⟨hA,hB,hn⟩

/-- The direction square is minus the unit times its base-field norm. -/
theorem direction_square (U : R) (q : ℤ) (hq : q≠0)
    (hH : relH (1+(4*q) • U)=1) (hK : relK (1+(4*q) • U)=0) :
    U^2= -(1+(4*q) • U)*(⟨![relH U,relK U,0,0]⟩:R) := by
  obtain ⟨hA,hB,_,_⟩ := trace_norm U q hq hH hK
  have htr : U+tau U= (-(4*q):ℤ) • (U*tau U) := by
    rw [mul_tau]
    ext j; fin_cases j
    · change U 0+U 0= -(4*q)*relH U; nlinarith only [hA]
    · change U 1+U 1= -(4*q)*relK U; nlinarith only [hB]
    · change U 2+(-U 2)= -(4*q)*0; ring
    · change U 3+(-U 3)= -(4*q)*0; ring
  simpa only [mul_tau] using
    RelativeDirection.square U (tau U) (U*tau U) (4*q) rfl htr

/-- Width and all first-coordinate divisibilities follow from the relative norm,
for every unit direction at a multiple of four. -/
theorem direction (U : R) (q : ℤ) (hq : q≠0)
    (hH : relH (1+(4*q) • U)=1) (hK : relK (1+(4*q) • U)=0) :
    (∀ y : R, (4:ℤ) ∣ (y*U) 0 ∧ (4:ℤ) ∣ (y*U) 1) ∧
    (∀ j, (4:ℤ) ∣ (U^2) j) ∧
    ((4:ℤ)=2 ∨ (8:ℤ) ∣ (U^2) 0+(U^2) 1) := by
  obtain ⟨hA,hB,hN0,hN1⟩ := trace_norm U q hq hH hK
  have hn := And.intro hN0 hN1
  obtain ⟨a,ha⟩ := hn.1
  obtain ⟨b,hb⟩ := hn.2
  have hu0 : U 0=4*(-2*q*a) := by rw [hA,ha]; ring
  have hu1 : U 1=4*(-2*q*b) := by rw [hB,hb]; ring
  let Z : R := ⟨![a,b,0,0]⟩
  have hN : (⟨![relH U,relK U,0,0]⟩:R)=(4:ℤ) • Z := by
    ext j; fin_cases j
    · exact ha
    · exact hb
    · change 0=4*0; ring
    · change 0=4*0; ring
  have hs := direction_square U q hq hH hK
  have hsquare : U^2=(4:ℤ) • (-(1+(4*q) • U)*Z) := by
    rw [hs,hN,mul_smul_comm]
  refine ⟨?_,?_,Or.inr ?_⟩
  · intro y
    constructor <;> simp only [mul_apply0,mul_apply1] <;> rw [hu0,hu1] <;> ring_nf <;> omega
  · intro j
    rw [hsquare,zsmul_apply]
    exact dvd_mul_right _ _
  · simp only [pow_two,mul_apply0,mul_apply1]
    rw [hu0,hu1]; ring_nf; omega
theorem base_mul (x : R) (H K : ℤ) :
    (x*(⟨![H,K,0,0]⟩:R)) 0=x 0*H+11*x 1*K ∧
    (x*(⟨![H,K,0,0]⟩:R)) 1=x 0*K+x 1*H := by
  constructor <;> simp only [mul_apply0,mul_apply1] <;> norm_num <;> ring

/-- The signed base-coordinate sum is fixed by each unit step modulo four. -/
theorem orbit_phase (i : ℤ) :
    (4:ℤ) ∣ (xi0*(↑(rhoU^i):R)) 0+(1)*(xi0*(↑(rhoU^i):R)) 1-1 := by
  have hs (x : R) : (4:ℤ) ∣
      (x*(rhoU:R)) 0+(1)*(x*(rhoU:R)) 1-(x 0+(1)*x 1) := by
    simp only [mul_apply0,mul_apply1]
    norm_num [rhoU,rho]; ring_nf; omega
  have hh := OrbitCongruence.invariant rhoU (fun x : R => x 0+(1)*x 1) 4 hs xi0 i
  simpa only [show xi0 0+(1)*xi0 1=1 by decide] using hh

/-- Width two is unconditional in y; width four uses its value modulo four. -/
theorem scalar_base (y U : R) (q : ℤ) (hq : q≠0)
    (hH : relH (1+(4*q) • U)=1) (hK : relK (1+(4*q) • U)=0)
    (hy : (4:ℤ) ∣ f y) (hphase : (4:ℤ) ∣ y 0+(1)*y 1-1) :
    (32:ℤ) ∣ Lf y (y*(⟨![relH U,relK U,0,0]⟩:R)) := by
  obtain ⟨hA,hB,hN0,hN1⟩ := trace_norm U q hq hH hK
  change (32:ℤ) ∣
    2*(y 0-3)*(y*(⟨![relH U,relK U,0,0]⟩:R)) 0-
      2*11*y 1*(y*(⟨![relH U,relK U,0,0]⟩:R)) 1
  rw [(base_mul y _ _).1,(base_mul y _ _).2]
  apply RelativeDirection.base_differential (y 0) (y 1) (relH U) (relK U) 11 4 hy hN0
  have hchar : (16:ℤ) ∣ relH U-(1)*relK U := by
    obtain ⟨a,ha⟩ := hN0; obtain ⟨b,hb⟩ := hN1
    have hu0 : U 0=4*(-2*q*a) := by rw [hA,ha]; ring
    have hu1 : U 1=4*(-2*q*b) := by rw [hB,hb]; ring
    simp only [relH,relK]; rw [hu0,hu1]; ring_nf; omega
  exact RelativeDirection.scalar_four (y 0) (y 1) (relH U) (relK U) 11 (1)
    (by decide) (by decide) hphase hN0 hchar

/-- The norm alone supplies the width-two scalar bit. Width four uses
only a modular value and the preserved orbit character. -/
theorem scalar (y U : R) (q : ℤ) (hq : q≠0)
    (hH : relH (1+(4*q) • U)=1) (hK : relK (1+(4*q) • U)=0)
    (hy : (4:ℤ) ∣ f y) (hphase : (4:ℤ) ∣ y 0+(1)*y 1-1) :
    (32:ℤ) ∣ Lf y (y*U^2) := by
  obtain ⟨_,_,hN0,hN1⟩ := trace_norm U q hq hH hK
  let N : R := ⟨![relH U,relK U,0,0]⟩
  apply RelativeDirection.scalar_of_norm (Lf y) y U N (4*q) 4
    (direction_square U q hq hH hK)
  · exact scalar_base y U q hq hH hK hy hphase
  · change (32:ℤ) ∣
      2*(y 0-3)*((y*U)*N) 0-2*11*y 1*((y*U)*N) 1
    rw [(base_mul (y*U) _ _).1,(base_mul (y*U) _ _).2]
    simpa only [show (2:ℤ)*4^2=32 by norm_num,mul_assoc] using
      RelativeDirection.product_differential (y 0-3) (11*y 1) 11
      ((y*U) 0) ((y*U) 1) (relH U) (relK U) 4
      ((direction U q hq hH hK).1 y).1
      ((direction U q hq hH hK).1 y).2 ((by decide : (4:ℤ) ∣ 4).trans hN0) hN1
/-- The shifted value and the constant norm coefficient are complementary modulo four. -/
theorem value_character (y : R) : (4:ℤ) ∣ f y+relH y-11 := by
  have hp := IntegerParity.square_sub_self_even (y 0)
  simp only [f,relH]; ring_nf; omega

/-- Coefficient estimates use these orbit congruences before any exact root. -/
theorem orbit_congruences (i : ℤ) :
    (4:ℤ) ∣ f (xi0*(↑(rhoU^i):R)) ∧
    (4:ℤ) ∣ relK (xi0*(↑(rhoU^i):R)) := by
  obtain ⟨hH,hK⟩ := relN_rho_zpow i
  have hv := value_character (xi0*(↑(rhoU^i):R))
  rw [relH_mul,hH,hK] at hv
  constructor
  · norm_num [relH,xi0] at hv
    exact hv
  · rw [relK_mul,hH,hK]
    norm_num [relK,xi0]

/-- After the norm has removed the base part, the derivative is a
pairing of the two relative coordinates. -/
def pairing (y U : R) : ℤ :=
  (189*(y 0-3)-11*57*y 1)*(y 2*U 2+11*y 3*U 3)+
  11*(57*(y 0-3)-189*y 1)*(y 2*U 3+y 3*U 2)

theorem derivative_pairing (y U : R) (q : ℤ) (hq : q≠0)
    (hH : relH (1+(4*q) • U)=1) (hK : relK (1+(4*q) • U)=0)
    (hy : (4:ℤ) ∣ f y) (hphase : (4:ℤ) ∣ y 0+(1)*y 1-1) :
    (64*q:ℤ) ∣ Lf y (y*U)-8*pairing y U := by
  obtain ⟨hA,hB,_,_⟩ := trace_norm U q hq hH hK
  have he : Lf y (y*U)-8*pairing y U=
      -(2*q)*Lf y (y*(⟨![relH U,relK U,0,0]⟩:R)) := by
    change 2*(y 0-3)*(y*U) 0-2*11*y 1*(y*U) 1-8*pairing y U=
      -(2*q)*(2*(y 0-3)*(y*(⟨![relH U,relK U,0,0]⟩:R)) 0-
        2*11*y 1*(y*(⟨![relH U,relK U,0,0]⟩:R)) 1)
    rw [(base_mul y _ _).1,(base_mul y _ _).2]
    simp only [mul_apply0,mul_apply1,pairing]
    rw [hA,hB]; ring
  rw [he]
  obtain ⟨a,ha⟩ := scalar_base y U q hq hH hK hy hphase
  exact ⟨-a,by rw [ha]; ring⟩

/-- Width four preserves the base coordinates modulo sixteen;
the relative coordinates need only the automatic congruence modulo four. -/
theorem phase_residues (V : Rˣ) (S : R) (hV : (V:R)=1+(4:ℤ) • S)
    (hH : relH (1+(4:ℤ) • S)=1) (hK : relK (1+(4:ℤ) • S)=0)
    (x : R) (i : ℤ) :
    (16:ℤ) ∣ (x*(↑(V^i):R)) 0-x 0 ∧
    (16:ℤ) ∣ (x*(↑(V^i):R)) 1-x 1 ∧
    (4:ℤ) ∣ (x*(↑(V^i):R)) 2-x 2 ∧
    (4:ℤ) ∣ (x*(↑(V^i):R)) 3-x 3 := by
  have hw := (direction S 1 (by decide) (by simpa using hH) (by simpa using hK)).1
  have hm (z : R) (j : Fin 4) : (z*(V:R)) j-z j=4*(z*S) j := by
    rw [hV,mul_add,mul_one,mul_smul_comm,add_apply,zsmul_apply]; ring
  have hs (j : Fin 4) (N : ℤ) (h : ∀ z : R, N ∣ 4*(z*S) j) :
      N ∣ (x*(↑(V^i):R)) j-x j :=
    OrbitCongruence.invariant V (fun z : R => z j) N (by intro z; rw [hm]; exact h z) x i
  refine ⟨hs 0 16 ?_,hs 1 16 ?_,hs 2 4 (by intro z; exact dvd_mul_right _ _),
    hs 3 4 (by intro z; exact dvd_mul_right _ _)⟩
  · intro z; obtain ⟨a,ha⟩ := (hw z).1; exact ⟨a,by rw [ha]; ring⟩
  · intro z; obtain ⟨a,ha⟩ := (hw z).2; exact ⟨a,by rw [ha]; ring⟩

/-- The phase determines the derivative as a linear form in the relative direction. -/
theorem derivative_odd (y U : R)
    (hH : relH (1+(4:ℤ) • U)=1) (hK : relK (1+(4:ℤ) • U)=0)
    (h0 : (16:ℤ) ∣ y 0-2) (h1 : (16:ℤ) ∣ y 1-3)
    (h2 : (4:ℤ) ∣ y 2-0) (h3 : (4:ℤ) ∣ y 3-1)
 :
    (64:ℤ) ∣ Lf y (y*U)-(-16*U 3) := by
  have hy : (4:ℤ) ∣ f y :=
    RelativeDirection.value_congruence (y 0) (y 1) 2 3 11 4 (by omega) (by omega) (by decide)
  have ho := derivative_pairing y U 1 (by decide) hH hK hy (by omega)
  norm_num only [Int.reduceMul] at ho
  have hr : (64:ℤ) ∣ 8*pairing y U-(-16*U 3) := by
    obtain ⟨A,hA⟩ := h0; obtain ⟨B,hB⟩ := h1
    obtain ⟨C,hC⟩ := h2; obtain ⟨D,hD⟩ := h3
    have ha : y 0=2+16*A := by omega
    have hb : y 1=3+16*B := by omega
    have hc : y 2=0+4*C := by omega
    have hd : y 3=1+4*D := by omega
    simp only [pairing]; rw [ha,hb,hc,hd]
    ring_nf; omega
  convert ho.add hr using 1; ring


end Tetrahedral.NormEleven.NormProjection66
