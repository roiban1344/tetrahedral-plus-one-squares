    obtain ⟨A,hA⟩ := h0; obtain ⟨B,hB⟩ := h1
    obtain ⟨C,hC⟩ := h2; obtain ⟨D,hD⟩ := h3
    have ha : y 0=8+16*A := by omega
    have hb : y 1=3+16*B := by omega
    have hc : y 2=2+4*C := by omega
    have hd : y 3=0+4*D := by omega
    simp only [pairing]; rw [ha,hb,hc,hd]
