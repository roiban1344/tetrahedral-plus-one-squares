    ((2:ℤ)=2 ∨ (4:ℤ) ∣ (U^2) 0+(U^2) 1) := by
  obtain ⟨hA,hB,hN0,hN1⟩ := trace_norm U q hq hH hK
  have hn := And.intro hN0 hN1
  obtain ⟨a,ha⟩ := hn.1
  obtain ⟨b,hb⟩ := hn.2
  have hu0 : U 0=2*(-2*q*a) := by rw [hA,ha]; ring
  have hu1 : U 1=2*(-2*q*b) := by rw [hB,hb]; ring
  let Z : R := ⟨![a,b,0,0]⟩
  have hN : (⟨![relH U,relK U,0,0]⟩:R)=(2:ℤ) • Z := by
    ext j; fin_cases j
    · exact ha
    · exact hb
    · change 0=2*0; ring
    · change 0=2*0; ring
  have hs := direction_square U q hq hH hK
  have hsquare : U^2=(2:ℤ) • (-(1+(4*q) • U)*Z) := by
    rw [hs,hN,mul_smul_comm]
  refine ⟨?_,?_,Or.inl rfl⟩
